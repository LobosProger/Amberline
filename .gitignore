sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*


# -----------------------------------------------------------------------------
# amberline - project specific. Read the comments before changing anything here.
# -----------------------------------------------------------------------------

# LlamaLib native binaries - 3.77 GiB, 116 files, seven of them over GitHub's
# 100 MB hard per-file limit (largest: 1141 MiB). Also contains NVIDIA CUDA
# redistributables (cublas64_12.dll, cublasLt64_12.dll, cudart64_12.dll) whose
# EULA does not clearly permit standalone redistribution in a source repo.
#
# These are downloaded and extracted automatically by LLM for Unity on first
# Editor open:
#   LLMUnitySetup.cs:103,109 -> https://github.com/undreamai/LlamaLib/releases/download/v2.0.2/LlamaLib-v2.0.2.zip
#   LLMUnitySetup.cs:255 [InitializeOnLoadMethod] -> DownloadLibrary() -> :508
#
# !! CRITICAL !! The exclude MUST cover setup/*.complete as well. That file is
# 0 bytes, and LLMUnitySetup.cs:453-455 returns early if it exists. Committing
# it makes a fresh clone SKIP the download and fail at runtime with NO error.
# The patterns below cover the whole tree, sentinel included. Do not narrow them.
/[Aa]ssets/[Ss]treamingAssets/LlamaLib-*/
/[Aa]ssets/[Ss]treamingAssets/LlamaLib-*.meta

# GGUF model weights - never commit these. LLM for Unity stores them outside the
# project (%APPDATA%\LLMUnity\models), so this is belt-and-braces only.
*.gguf
*.gguf.meta

# NuGet DLLs restored by com.ivanmurzak.unity.mcp - 18 MiB, 43 DLLs.
# Regenerated on every domain reload:
#   NuGetConfig.cs:42             InstallPath = "Assets/Plugins/NuGet"
#   NuGetDependencyResolver.cs:54 [InitializeOnLoad]
/[Aa]ssets/[Pp]lugins/NuGet/
/[Aa]ssets/[Pp]lugins/NuGet.meta

# Windows reserved device name. A file called "nul" cannot be checked out on
# Windows, so its presence breaks `git clone` for every Windows user.
nul

# Local AI-assistant state: generated MCP tool docs plus local permissions.
# All regenerable; noise in a public repo.
.claude/

# Private, machine-local instructions - explicitly not for checking in.
CLAUDE.local.md

# Package samples imported through the Package Manager. Regenerable from the
# LLM for Unity package on demand, and only ever imported here to compare our
# own path against the package's ChatBot sample.
/[Aa]ssets/[Ss]amples/
/[Aa]ssets/[Ss]amples.meta
